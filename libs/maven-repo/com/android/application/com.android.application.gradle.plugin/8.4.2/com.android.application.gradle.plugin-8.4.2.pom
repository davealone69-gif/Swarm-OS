<?xml version="1.0" encoding="UTF-8"?>
<!--
  Plugin Marker POM for com.android.application plugin (AGP 8.4.2).

  Gradle's plugin resolution mechanism looks for an artifact at:
    <pluginId>:<pluginId>.gradle.plugin:<version>
  This POM redirects that lookup to the real AGP implementation artifact.

  To populate this file (and the accompanying .jar) in an offline environment,
  run:  ./scripts/vendor-agp.sh
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.android.application</groupId>
  <artifactId>com.android.application.gradle.plugin</artifactId>
  <version>8.4.2</version>
  <packaging>pom</packaging>

  <dependencies>
    <dependency>
      <groupId>com.android.tools.build</groupId>
      <artifactId>gradle</artifactId>
      <version>8.4.2</version>
    </dependency>
  </dependencies>
</project>
