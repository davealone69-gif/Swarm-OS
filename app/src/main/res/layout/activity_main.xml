<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swarm Builder"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#58A6FF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Prompt-driven multi-agent build loop"
            android:textSize="14sp"
            android:textColor="#8B949E" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#21262D" />

        <!-- Task input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TASK"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.08" />

        <EditText
            android:id="@+id/input_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="88dp"
            android:gravity="top|start"
            android:background="#161B22"
            android:padding="14dp"
            android:hint="Describe what the swarm should build…"
            android:textColorHint="#484F58"
            android:textColor="#E6EDF3"
            android:textSize="15sp"
            android:inputType="textMultiLine" />

        <!-- Topology -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="TOPOLOGY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.08" />

        <Spinner
            android:id="@+id/spinner_topology"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="#161B22"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Agents -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="AGENTS + SYSTEM PROMPTS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/agents_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Run -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_run_swarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="▶  Run Swarm"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:backgroundTint="#238636"
            app:cornerRadius="10dp" />

        <!-- Output log -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SWARM OUTPUT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/output_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="160dp"
            android:background="#161B22"
            android:padding="14dp"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:text="Ready. Enter a task and run the swarm." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="v1.0 · Prompt Swarm Builder"
            android:textSize="11sp"
            android:textColor="#484F58" />

    </LinearLayout>
</ScrollView>
