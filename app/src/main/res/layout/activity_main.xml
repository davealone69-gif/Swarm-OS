<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0D1117">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Swarm OS"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#58A6FF"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Command centre for your AI agent ecosystem"
            android:textSize="15sp"
            android:textColor="#8B949E" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#21262D" />

        <!-- Status row -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/status_online"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#161B22"
                android:padding="16dp"
                android:text="● ONLINE"
                android:textColor="#3FB950"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/status_agents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#161B22"
                android:padding="16dp"
                android:text="0 agents"
                android:textColor="#E6EDF3"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Board columns -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="BOARD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/board_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- Quick actions -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="QUICK ACTIONS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#8B949E"
            android:letterSpacing="0.1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_agent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="+ New Agent"
            android:textAllCaps="false"
            app:backgroundTint="#238636"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_project"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="+ New Project"
            android:textAllCaps="false"
            android:textColor="#58A6FF"
            app:strokeColor="#30363D"
            app:cornerRadius="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_report_bug"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Report Bug"
            android:textAllCaps="false"
            android:textColor="#F85149"
            app:strokeColor="#30363D"
            app:cornerRadius="8dp" />

        <!-- Footer -->
        <TextView
            android:id="@+id/footer_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="v1.0 · Offline AGP build"
            android:textSize="12sp"
            android:textColor="#484F58" />

    </LinearLayout>
</ScrollView>
