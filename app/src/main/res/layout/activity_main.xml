<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Tab bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#161B22">

        <TextView
            android:id="@+id/tab_builder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Swarm Builder"
            android:textColor="#58A6FF"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_training"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Training Centre"
            android:textColor="#8B949E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="API Keys"
            android:textColor="#8B949E"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#21262D" />

    <!-- BUILDER PANEL -->
    <ScrollView
        android:id="@+id/panel_builder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8B949E"
                android:letterSpacing="0.08" />

            <EditText
                android:id="@+id/input_task"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="72dp"
                android:gravity="top|start"
                android:background="#161B22"
                android:padding="12dp"
                android:hint="Describe what the swarm should build…"
                android:textColorHint="#484F58"
                android:textColor="#E6EDF3"
                android:textSize="14sp"
                android:inputType="textMultiLine" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="TOPOLOGY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8B949E"
                android:letterSpacing="0.08" />

            <Spinner
                android:id="@+id/spinner_topology"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="#161B22"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AGENTS + PROMPTS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8B949E"
                    android:letterSpacing="0.08" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_agent"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="+ Add"
                    android:textAllCaps="false"
                    android:textColor="#58A6FF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/agents_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_run_swarm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="▶  Run Swarm"
                android:textAllCaps="false"
                android:textSize="15sp"
                app:backgroundTint="#238636"
                app:cornerRadius="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SWARM OUTPUT"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8B949E"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/output_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="140dp"
                android:background="#161B22"
                android:padding="12dp"
                android:textColor="#E6EDF3"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="Ready. Enter a task and run the swarm." />
        </LinearLayout>
    </ScrollView>

    <!-- TRAINING PANEL -->
    <ScrollView
        android:id="@+id/panel_training"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skill Library"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#58A6FF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Prompt snippets learned from successful builds"
                android:textSize="13sp"
                android:textColor="#8B949E" />

            <LinearLayout
                android:id="@+id/skills_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Build Trajectories"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#58A6FF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Past swarm runs scored for learning"
                android:textSize="13sp"
                android:textColor="#8B949E" />

            <LinearLayout
                android:id="@+id/trajectories_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- SETTINGS PANEL -->
    <ScrollView
        android:id="@+id/panel_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Free LLM API Keys"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#58A6FF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Leave blank to use offline simulation. Keys stay on device."
                android:textSize="13sp"
                android:textColor="#8B949E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="GROQ API KEY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8B949E" />

            <EditText
                android:id="@+id/input_groq_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#161B22"
                android:padding="12dp"
                android:hint="gsk_…"
                android:textColorHint="#484F58"
                android:textColor="#E6EDF3"
                android:inputType="textPassword"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="OPENROUTER API KEY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8B949E" />

            <EditText
                android:id="@+id/input_openrouter_key"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#161B22"
                android:padding="12dp"
                android:hint="sk-or-…"
                android:textColorHint="#484F58"
                android:textColor="#E6EDF3"
                android:inputType="textPassword"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_keys"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Save Keys"
                android:textAllCaps="false"
                app:backgroundTint="#238636"
                app:cornerRadius="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Free models: Llama 3 8B/70B, Gemma 2, Mixtral (Groq) · OpenRouter free · Simulate offline"
                android:textSize="12sp"
                android:textColor="#484F58" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
